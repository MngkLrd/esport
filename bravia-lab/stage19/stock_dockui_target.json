{
  "schema_version": 1,
  "name": "BRAVIA STOCK DOCKUI REPLACEMENT CONTRACT",
  "target": "KD-55XG7096",
  "baseline_firmware": "Sony v8.931-1000 (owner OTA read-only research)",
  "launch_surface": "Sony native dockui",
  "goal": "Replace only HOME content, preserve host display/tuner/audio/TV and all system keys",
  "launch_constraint": "No installed or confirmed USB loader; policy is offline only; NOT a firmware update",
  "legacy_apps_policy": {
    "action": "REPLACE_ENTIRE_LEGACY_APPLICATIONS_ROW",
    "preserve_legacy_shortcuts": false,
    "match_mode": "legacy row independent of vendor service ID",
    "legacy_examples": [
      "Netflix",
      "YouTube",
      "ivi",
      "Okko",
      "Prime Video",
      "START",
      "Megafon",
      "Berlin Philharmonic",
      "legacy browser",
      "radio",
      "clock",
      "legacy media shortcuts"
    ],
    "overlap_rule": "If a name appears in both legacy and desired catalogs, the new tile remains a separately defined user entry; using an existing working native Sony app runtime is allowed only after host verification. Never assume a sideloaded APK is compatible.",
    "remove_vendor_binaries": false
  },
  "desired_home_order": [
